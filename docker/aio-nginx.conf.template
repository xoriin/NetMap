user netmap netmap;
worker_processes auto;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  access_log /dev/stdout;
  error_log /dev/stderr warn;

  sendfile on;
  tcp_nopush on;
  keepalive_timeout 65;

  client_body_temp_path /tmp/nginx/client_body;
  proxy_temp_path /tmp/nginx/proxy;
  fastcgi_temp_path /tmp/nginx/fastcgi;
  uwsgi_temp_path /tmp/nginx/uwsgi;
  scgi_temp_path /tmp/nginx/scgi;

  # Written by aio-entrypoint.sh: real_ip settings for TRUSTED_PROXY_IPS and
  # the $netmap_trusted_upstream flag used below.
  include /tmp/nginx-realip.conf;

  # Pass an upstream proxy's X-Forwarded-Proto through only when that proxy
  # is trusted; otherwise report the scheme nginx itself received.
  map "$netmap_trusted_upstream:$http_x_forwarded_proto" $netmap_forwarded_proto {
    default $scheme;
    "1:https" https;
    "1:http" http;
  }

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

server {
    client_max_body_size 256m;
    listen ${APP_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
      proxy_pass http://unix:/tmp/uvicorn.sock:;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      # Overwrite, never append: the backend trusts these headers on its
      # Unix socket, so client-supplied values must not reach it.
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $netmap_forwarded_proto;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 600s;
    }

    location /assets/ {
      add_header Cache-Control "public, max-age=31536000, immutable";
      try_files $uri =404;
    }

    location / {
      add_header Cache-Control "no-cache";
      try_files $uri $uri/ /index.html;
    }
  }
}
